# Optional: force the one canonical public domain (without a trailing slash), e.g. https://tripfinder.example.com.
# If omitted on Vercel, the project production domain is used automatically.
SITE_URL=

# Server-side only. Never prefix these with NEXT_PUBLIC_.
# SerpApi account/API key: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Neon PostgreSQL connection string from the Neon dashboard.
# Use the pooled connection string for the Vercel serverless deployment.
DATABASE_URL=

# Shared app-level cap for uncached provider requests per UTC calendar month.
# The current SerpApi Free plan advertises 250 searches/month. Tripfinder defaults
# to 200 to leave a reserve for manual testing and provider retries; max is 230.
# Failed attempts count conservatively in Tripfinder's own counter.
SERPAPI_MONTHLY_SEARCH_CAP=200

# Shared safety cap across all visitors per UTC hour. Default 30 vs SerpApi's
# currently advertised 50 searches/hour, leaving room for other account usage.
SERPAPI_HOURLY_SEARCH_CAP=30

# Pause new provider searches when the SerpApi account has this many searches
# or fewer remaining. The provider Account API is free and does not use a search.
SERPAPI_PROVIDER_QUOTA_RESERVE=75

# Stop uncached searches when the provider Account API reports this many or
# fewer searches remaining in the current hour. The Account API is free.
SERPAPI_PROVIDER_HOURLY_RESERVE=10


# Private /admin dashboard login secret. Use a random value of at least 32 characters.
# Enter this same value on /admin. Server-side only; never use NEXT_PUBLIC_.
ADMIN_DASHBOARD_SECRET=
