# Optional: force the one canonical public domain (without a trailing slash), e.g. https://tripfinder.example.com.
# If omitted on Vercel, the project production domain is used automatically.
SITE_URL=

# Optional public tip/support destination. This is a URL, not a secret.
# If unset or invalid, the app uses the Streamlabs link supplied for Tripfinder.
SUPPORT_TIP_URL=https://streamlabs.com/artofreyes/tip

# Server-side only. Never prefix these with NEXT_PUBLIC_.
# SerpApi account/API key: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Optional server-side POI and driving-route provider powered by OpenStreetMap.
# When configured, Tripfinder uses Geoapify for local activities, restaurants,
# and coordinate-based driving estimates. Otherwise it keeps the SerpApi Maps/Local path.
# Geoapify free plan currently advertises 3,000 credits/day; Tripfinder defaults
# to 2,400 shared credits/day and 80 credits per visitor/day as safety limits.
# Uncached Geoapify requests are also spaced by a shared Neon-backed rate gate.
GEOAPIFY_API_KEY=
GEOAPIFY_DAILY_CREDIT_CAP=2400
GEOAPIFY_CLIENT_DAILY_CREDIT_CAP=80

# Neon PostgreSQL connection string from the Neon dashboard.
# Use the pooled connection string for the Vercel serverless deployment.
DATABASE_URL=

# Shared app-level cap for uncached provider requests per UTC calendar month.
# The current SerpApi Free plan advertises 250 searches/month. Tripfinder defaults
# to 200 to leave a reserve for manual testing and provider retries; max is 230.
# Failed attempts count conservatively in Tripfinder's own counter.
SERPAPI_MONTHLY_SEARCH_CAP=200

# Shared safety cap across all visitors per UTC hour. Default 30 vs SerpApi's
# currently advertised 50 searches/hour, leaving room for other account usage.
SERPAPI_HOURLY_SEARCH_CAP=30

# Pause new provider searches when the SerpApi account has this many searches
# or fewer remaining. The provider Account API is free and does not use a search.
SERPAPI_PROVIDER_QUOTA_RESERVE=75

# Stop uncached searches when the provider Account API reports this many or
# fewer searches remaining in the current hour. The Account API is free.
SERPAPI_PROVIDER_HOURLY_RESERVE=10


# Private /admin dashboard login secret. Use a random value of at least 32 characters.
# Enter this same value on /admin. Server-side only; never use NEXT_PUBLIC_.
ADMIN_DASHBOARD_SECRET=


# Optional Booking.com Demand API v3.3 integration. Requires approved Managed Affiliate Partner access.
# Obtain the API token and Affiliate ID through Booking.com Partner Centre; do not commit real values.
# Use the sandbox URL only with sandbox credentials; otherwise leave the default production URL.
BOOKING_COM_API_BASE=https://demandapi.booking.com/3.3
BOOKING_COM_API_TOKEN=
BOOKING_COM_AFFILIATE_ID=
# Country where the traveler is booking from (ISO-2). Defaults to us.
BOOKING_COM_BOOKER_COUNTRY=us


# Optional AI-assisted comparison of already-loaded Tripfinder results. These providers
# do not replace SerpApi and do not consume Tripfinder's travel-search quota.
# OpenRouter's free router is attempted first and is restricted to non-collecting,
# zero-data-retention endpoints. Keep the model on openrouter/free or a :free variant.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Gemini free-tier fallback is only called when the visitor explicitly opts in.
# Use a Google AI Studio project without billing enabled to avoid paid-tier charges.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Shared app-level daily limits. OpenRouter default stays below its 50/day free cap;
# Gemini's actual free quota varies by project/model and must be checked in AI Studio.
AI_OPENROUTER_DAILY_CAP=40
AI_GEMINI_DAILY_CAP=30
AI_CLIENT_DAILY_CAP=5
